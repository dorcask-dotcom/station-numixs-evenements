{
  "name": "station-numixs",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/events.json", "/admin*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "station-numixs" }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "numixs.cloudflareaccess.com",
    "ACCESS_AUD": "fde51c3b179ecbac618982e59564f54a414a15958d00982c54cd7d533143e690"
  },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
