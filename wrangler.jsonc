{
  "name": "station-numixs",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/events.json"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "station-numixs" }
  ],
  "triggers": { "crons": ["*/30 * * * *"] },
  "observability": { "enabled": true }
}
